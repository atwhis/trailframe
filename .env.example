# Server-only Mapbox public token with styles:tiles scope.
# Never expose this value through a VITE_ variable or commit a real token.
MAPBOX_ACCESS_TOKEN=
MAPBOX_STYLE=mapbox/outdoors-v12
# Optional custom Mapbox Studio classic style. Leave empty to use the built-in
# mapbox/satellite-streets-v12 fallback. See docs/mapbox-guidebook-style.md.
MAPBOX_GUIDEBOOK_STYLE=
PORT=8787
WEB_ORIGIN=http://localhost:5173
